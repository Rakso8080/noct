{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noct-crowd",
  "main": "crowd/src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noct-crowd",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
