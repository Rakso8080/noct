{
  "name": "spark-daily",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.ts",
    "verify": "node scripts/verify.ts",
    "verify:prompts": "node scripts/verify-prompts.ts",
    "dev:sites": "npm run build && npm run build:worker && wrangler dev --config wrangler.worker.jsonc --port 8790",
    "crowd:dev": "wrangler dev --port 8787 --local",
    "crowd:db": "wrangler d1 execute DB --local --file=./crowd/schema.sql"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "trystero": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.168.0"
  }
}
